# Normalise line endings in the repository; check out with the platform's default.
* text=auto

# The Unix wrapper script must keep LF or it fails on macOS/Linux/CI.
gradlew text eol=lf
*.sh    text eol=lf

# Windows scripts keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary files: never touch.
*.jar   binary
*.ttf   binary
*.otf   binary
*.png   binary
*.webp  binary
